
{
  "entities": {
    "Admin": {
      "title": "Admin",
      "type": "object",
      "description": "Represents an administrator user for managing the Global Trusera Holdings website.",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      },
      "required": ["id", "username", "email"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "type": "object",
      "description": "Represents a customer testimonial.",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "testimonialText": { "type": "string" },
        "imageURL": { "type": "string", "format": "uri" }
      },
      "required": ["id", "customerName", "testimonialText", "imageURL"]
    },
    "ContactFormSubmission": {
      "title": "ContactFormSubmission",
      "type": "object",
      "description": "Represents a contact form submission.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "message": { "type": "string" },
        "submissionDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "message", "submissionDate"]
    },
    "Banner": {
      "title": "Banner",
      "type": "object",
      "description": "Represents a dynamic banner.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "linkUrl": { "type": "string", "format": "uri" },
        "serviceType": { "type": "string" }
      },
      "required": ["id", "title", "imageUrl", "linkUrl", "serviceType"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user profile.",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "displayName": { "type": "string" },
        "phone": { "type": "string" },
        "birthDate": { "type": "string", "format": "date" },
        "gender": { "type": "string" },
        "religion": { "type": "string" },
        "homeAddress": { "type": "string" },
        "state": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "zipcode": { "type": "string" },
        "kinFirstName": { "type": "string" },
        "kinLastName": { "type": "string" },
        "kinRelationship": { "type": "string" },
        "kinAddress": { "type": "string" },
        "preferredCurrency": { "type": "string" },
        "accountType": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "accountBalance": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive", "suspended"] }
      },
      "required": ["email", "firstName", "lastName", "displayName", "phone", "birthDate", "homeAddress", "city", "state", "zipcode", "country", "preferredCurrency", "accountType", "status", "accountBalance"]
    },
    "Transaction": {
      "title": "Transaction",
      "type": "object",
      "description": "Represents a financial transaction.",
      "properties": {
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["deposit", "withdrawal", "transfer", "sale", "refund"] },
        "status": { "type": "string", "enum": ["approved", "pending", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "recipient": { "type": "string" }
      },
      "required": ["amount", "type", "status", "createdAt", "description"]
    },
    "Conversation": {
      "title": "Conversation",
      "type": "object",
      "description": "Represents a support chat conversation.",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastUpdatedAt": { "type": "string", "format": "date-time" },
        "isReadByUser": { "type": "boolean" },
        "isReadByAdmin": { "type": "boolean" }
      },
      "required": ["userId", "userName", "lastMessage", "lastUpdatedAt", "isReadByUser", "isReadByAdmin"]
    },
    "Message": {
      "title": "Message",
      "type": "object",
      "description": "Represents a single chat message.",
      "properties": {
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "senderType": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "senderId", "senderType", "createdAt"]
    },
    "Card": {
      "title": "Card",
      "type": "object",
      "description": "Represents a banking card.",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["debit", "credit", "virtual"] },
        "nameOnCard": { "type": "string" },
        "cardNumber": { "type": "string" },
        "expiryDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "blocked", "pending"] },
        "brand": { "type": "string", "enum": ["visa", "mastercard", "amex"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "price": { "type": "number" }
      },
      "required": ["type", "nameOnCard", "cardNumber", "expiryDate", "status", "brand", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous", "google.com"]
  },
  "firestore": {
    "/testimonials/{testimonialId}": {
      "schema": { "$ref": "#/backend/entities/Testimonial" },
      "description": "Stores customer testimonials."
    },
    "/contact_form_submissions/{contactFormSubmissionId}": {
      "schema": { "$ref": "#/backend/entities/ContactFormSubmission" },
      "description": "Stores contact form submissions."
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/backend/entities/Banner" },
      "description": "Stores dynamic banners."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/backend/entities/Admin" },
      "description": "Stores administrator accounts."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Stores user profile information."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/backend/entities/Transaction" },
      "description": "Stores user transactions."
    },
    "/users/{userId}/cards/{cardId}": {
      "schema": { "$ref": "#/backend/entities/Card" },
      "description": "Stores user cards."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/backend/entities/Conversation" },
      "description": "Stores support conversation metadata."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/backend/entities/Message" },
      "description": "Stores individual chat messages."
    }
  }
}
