{
  "entities": {
    "Admin": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Admin",
      "type": "object",
      "description": "Represents an administrator user for managing the Global Trusera Holdings website.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Admin entity."
        },
        "username": {
          "type": "string",
          "description": "The username of the administrator."
        },
        "email": {
          "type": "string",
          "description": "The email address of the administrator.",
          "format": "email"
        }
      },
      "required": [
        "id",
        "username",
        "email"
      ]
    },
    "Testimonial": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Testimonial",
      "type": "object",
      "description": "Represents a customer testimonial displayed on the Global Trusera Holdings website.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Testimonial entity."
        },
        "customerName": {
          "type": "string",
          "description": "The name of the customer providing the testimonial."
        },
        "testimonialText": {
          "type": "string",
          "description": "The text content of the testimonial."
        },
        "imageURL": {
          "type": "string",
          "description": "URL to a high resolution image of the customer.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "customerName",
        "testimonialText",
        "imageURL"
      ]
    },
    "ContactFormSubmission": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ContactFormSubmission",
      "type": "object",
      "description": "Represents a contact form submission from a potential customer.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the ContactFormSubmission entity."
        },
        "name": {
          "type": "string",
          "description": "The name of the person submitting the form."
        },
        "email": {
          "type": "string",
          "description": "The email address of the person submitting the form.",
          "format": "email"
        },
        "message": {
          "type": "string",
          "description": "The message content submitted through the form."
        },
        "submissionDate": {
          "type": "string",
          "description": "The date and time the form was submitted.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "message",
        "submissionDate"
      ]
    },
    "Banner": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Banner",
      "type": "object",
      "description": "Represents a dynamic banner displayed on the Global Trusera Holdings website.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Banner entity."
        },
        "title": {
          "type": "string",
          "description": "The title of the banner."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL to the banner image.",
          "format": "uri"
        },
        "linkUrl": {
          "type": "string",
          "description": "URL the banner links to when clicked.",
          "format": "uri"
        },
        "serviceType": {
          "type": "string",
          "description": "The type of service this banner promotes (e.g., Loan Services, Savings Services, Stock Trading Services)."
        }
      },
      "required": [
        "id",
        "title",
        "imageUrl",
        "linkUrl",
        "serviceType"
      ]
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user profile containing information from the signup form.",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "displayName": { "type": "string", "description": "The user's full name."},
        "phone": { "type": "string" },
        "birthDate": { "type": "string", "format": "date" },
        "gender": { "type": "string" },
        "religion": { "type": "string" },
        "homeAddress": { "type": "string" },
        "state": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "zipcode": { "type": "string" },
        "kinFirstName": { "type": "string" },
        "kinLastName": { "type": "string" },
        "kinRelationship": { "type": "string" },
        "kinAddress": { "type": "string" },
        "preferredCurrency": { "type": "string" },
        "accountType": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "accountBalance": { "type": "number", "description": "The user's current account balance." },
        "status": {
          "type": "string",
          "enum": ["active", "inactive", "suspended"],
          "description": "The current status of the user's account."
        }
      },
      "required": [
        "email",
        "firstName",
        "lastName",
        "displayName",
        "phone",
        "birthDate",
        "homeAddress",
        "city",
        "state",
        "zipcode",
        "country",
        "preferredCurrency",
        "accountType",
        "status",
        "accountBalance"
      ]
    },
    "Transaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Transaction",
      "type": "object",
      "description": "Represents a financial transaction in the system.",
      "properties": {
        "amount": { "type": "number", "description": "The amount of the transaction." },
        "type": { "type": "string", "enum": ["deposit", "withdrawal", "transfer", "sale", "refund"], "description": "The type of transaction." },
        "status": { "type": "string", "enum": ["approved", "pending", "declined"], "description": "The status of the transaction." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of the transaction." },
        "description": { "type": "string", "description": "A user-provided description for the transaction." },
        "recipient": { "type": "string", "description": "Recipient details for withdrawals or transfers." }
      },
      "required": ["amount", "type", "status", "createdAt", "description"]
    },
    "Conversation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Conversation",
      "type": "object",
      "description": "Represents a chat conversation between a user and an admin.",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the user in the conversation." },
        "userName": { "type": "string", "description": "The name of the user in the conversation." },
        "lastMessage": { "type": "string", "description": "A snippet of the last message sent." },
        "lastUpdatedAt": { "type": "string", "format": "date-time", "description": "Timestamp of the last message." },
        "isReadByUser": { "type": "boolean", "description": "Indicates if the user has read the last message." },
        "isReadByAdmin": { "type": "boolean", "description": "Indicates if an admin has read the last message." }
      },
      "required": ["userId", "userName", "lastMessage", "lastUpdatedAt", "isReadByUser", "isReadByAdmin"]
    },
    "Message": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Message",
      "type": "object",
      "description": "Represents a single message within a conversation.",
      "properties": {
        "text": { "type": "string", "description": "The content of the message." },
        "senderId": { "type": "string", "description": "The UID of the message sender." },
        "senderType": { "type": "string", "enum": ["user", "admin"], "description": "The role of the sender." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when the message was sent." }
      },
      "required": ["text", "senderId", "senderType", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/testimonials/{testimonialId}",
        "definition": {
          "entityName": "Testimonial",
          "schema": {
            "$ref": "#/backend/entities/Testimonial"
          },
          "description": "Stores customer testimonials for display on the Global Trusera Holdings website."
        }
      },
      {
        "path": "/contact_form_submissions/{contactFormSubmissionId}",
        "definition": {
          "entityName": "ContactFormSubmission",
          "schema": {
            "$ref": "#/backend/entities/ContactFormSubmission"
          },
          "description": "Stores contact form submissions from potential customers."
        }
      },
      {
        "path": "/banners/{bannerId}",
        "definition": {
          "entityName": "Banner",
          "schema": {
            "$ref": "#/backend/entities/Banner"
          },
          "description": "Stores dynamic banner information for display on the Global Trusera Holdings website."
        }
      },
      {
        "path": "/admins/{adminId}",
        "definition": {
          "entityName": "Admin",
          "schema": {
            "$ref": "#/backend/entities/Admin"
          },
          "description": "Stores administrator user accounts. The presence of a document with a matching {adminId} grants admin privileges."
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Stores public user profile information."
        }
      },
      {
        "path": "/users/{userId}/transactions/{transactionId}",
        "definition": {
            "entityName": "Transaction",
            "schema": {
                "$ref": "#/backend/entities/Transaction"
            },
            "description": "Stores all financial transactions for a specific user."
        }
      },
      {
        "path": "/conversations/{conversationId}",
        "definition": {
            "entityName": "Conversation",
            "schema": {
                "$ref": "#/backend/entities/Conversation"
            },
            "description": "Stores metadata for a single chat conversation between a user and an admin."
        }
      },
      {
        "path": "/conversations/{conversationId}/messages/{messageId}",
        "definition": {
            "entityName": "Message",
            "schema": {
                "$ref": "#/backend/entities/Message"
            },
            "description": "Stores the individual messages within a conversation."
        }
      }
    ]
  }
}
