
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && !exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow get, list: if isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read, list: if isOwner(userId) || isAdmin();
        // Allow users to create 'pending' transactions, but not 'approved' ones.
        allow create: if isOwner(userId) && request.resource.data.status == 'pending';
        // Only admins can update (approve/decline) or delete transactions.
        allow update, delete: if isAdmin();
      }
    }

    match /testimonials/{testimonialId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /contact_form_submissions/{contactFormSubmissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
