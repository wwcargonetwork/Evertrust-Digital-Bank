
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // An admin is any signed-in user who does NOT have a document in the /users collection.
    // This is a simple convention for this app.
    function isAdmin() {
      return isSignedIn() && !exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow create: if true; // Anyone can create a user profile (sign up)
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false; // Don't allow users to delete their accounts

      match /transactions/{transactionId} {
        // Admins can list all transactions (for collection group query) and read any single one.
        // Owners can only read their own.
        allow list, read: if isAdmin() || isOwner(userId);
        
        // Allow users OR admins to create 'pending' transactions.
        allow create: if (isOwner(userId) || isAdmin()) && request.resource.data.status == 'pending';
        
        // Only admins can update (approve/decline) or delete transactions.
        allow update, delete: if isAdmin();
      }

      match /notifications/{notificationId} {
        // User can read and list their own notifications.
        allow get, list: if isOwner(userId);
        // User can update their own notifications (e.g., mark as read).
        allow update: if isOwner(userId);
        // Allow both admins and the account owner to create notifications.
        allow create: if isAdmin() || isOwner(userId);
      }
    }
    
    match /conversations/{conversationId} {
        // Users can list/read conversations they are part of. Admins can read all.
        allow list, get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
        // Users can create conversations.
        allow create: if isSignedIn();
        // Allow users to update their own conversation metadata (lastMessage, lastUpdatedAt) when sending messages.
        allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

        match /messages/{messageId} {
            // Users can read messages in their own conversations. Admins can read all.
            allow list, get: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid);
            // Users can create messages in their own conversations. Admins can create messages in any.
            allow create: if (isAdmin() && request.resource.data.senderType == 'admin') || (isOwner(request.resource.data.senderId) && request.resource.data.senderType == 'user');
        }
    }

    match /testimonials/{testimonialId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /contact_form_submissions/{contactFormSubmissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // New collection for admin notifications
    match /admin_notifications/{notificationId} {
        allow read, list, update: if isAdmin();
        allow create: if isSignedIn(); // Any signed-in user can create an application
    }
  }
}
