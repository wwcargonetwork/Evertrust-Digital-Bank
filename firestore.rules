/**
 * Core Philosophy:
 * This ruleset implements a Role-Based Access Control (RBAC) model centered around a
 * single "Admin" role. The security posture is designed to support a public-facing
 * website where content is managed by a trusted set of administrators.
 *
 * Data Structure:
 * The data is organized into several distinct, top-level collections:
 * - /testimonials: Publicly readable content managed by Admins.
 * - /banners: Publicly readable content managed by Admins.
 * - /contact_form_submissions: A write-only "dropbox" for public users, readable only by Admins.
 * - /admins: A collection where the existence of a document signifies a user has Admin privileges.
 * - /users: Stores public profiles for registered users.
 * - /transactions: Stores financial transactions, readable only by Admins or the user who owns them.
 *
 * Key Security Decisions:
 * - Admin Role by Existence: A user is considered an Admin if a document exists for them at the path `/admins/{userId}`.
 * - Owner-Only Writes: Users can only write to their own document in `/users` and create their own transactions in `/transactions`.
 * - Public Read, Admin Write: Collections for public display (/testimonials, /banners) are readable by anyone but managed only by Admins.
 * - Segregated Private Data: Contact forms and transactions are separated to control access strictly.
 * - Admin Management: Only Admins can manage other Admins.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user is an administrator.
     * Admin status is granted by the existence of a document in the /admins collection
     * with an ID matching the user's UID.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /**
     * A robust check for admin-only write operations (update, delete).
     * Ensures the user is an admin AND the document they are trying to modify exists.
     */
    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    /**
     * Checks if the requesting user is the owner of the document.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    /**
     * @description Manages public user profiles. Users can create, read, and update
     *              their own profile. Admins have read-only access.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read, update: if isOwner(userId);
      allow get, list: if isAdmin();
      allow delete: if false; // Deletion should be handled by a backend process
    }

    /**
     * @description Manages customer testimonials. Publicly readable, admin-managed.
     * @path /testimonials/{testimonialId}
     */
    match /testimonials/{testimonialId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Write-only dropbox for public contact forms. Readable only by admins.
     * @path /contact_form_submissions/{contactFormSubmissionId}
     */
    match /contact_form_submissions/{contactFormSubmissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    /**
     * @description Manages dynamic website banners. Publicly readable, admin-managed.
     * @path /banners/{bannerId}
     */
    match /banners/{bannerId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Manages administrator accounts. Only other admins can manage this list.
     * @path /admins/{adminId}
     */
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
    
    /**
     * @description Manages financial transactions. Users can create their own transactions.
     *              Admins have full read/write access for management.
     * @path /transactions/{transactionId}
     */
    match /transactions/{transactionId} {
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow read: if isAdmin() || isOwner(resource.data.userId);
        allow list, update, delete: if isAdmin();
    }
  }
}
